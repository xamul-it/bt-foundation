# Profilo paper "challenger": OvernightAHFlatComposite (Studio 5/6, score
# composito a 21 indicatori) contro il conto paper dedicato "challenger" --
# NON sostituisce "development", gira in parallelo su un account separato.
# Vedi docs/context/ah_flat_composite_deployment_brief.md.
#
# Pesi (STUDY5_WEIGHTS) identici a quelli confermati con Backtrader reale
# nello Studio 6 (docs/context/ah_context.md, sezione "Studio 6"):
# ann_log_ret 0.3822 (composito) vs 0.3634 (controllo) sul periodo pool
# 2000->2022-08-07 -- risultato positivo ma IN-SAMPLE (i pesi sono stati
# ottimizzati proprio su questo periodo), non ancora validato out-of-sample.
# monthly_universe_indicator_panel punta al pannello "live" rigenerato ogni
# mese da scripts/refresh-indicator-panel.sh (non piu' l'export statico
# del giorno della ricerca).
#
# Filtri/hedge/cooldown allineati alla configurazione "development" attuale
# (2026-08-16, min_intraday_vol/min_adv neutralizzati, solo ah_lag1 attivo
# -- lo scenario in cui lo studio "Isolamento dei tre filtri" ha mostrato il
# vantaggio maggiore del composito, +21,77% vs controllo a parita' di
# setup). NON e' una promozione a produzione: solo parita' di condizioni
# operative per un confronto paper equo tra "development" e "challenger".

STRAT=overnight_ah_flat_composite.OvernightAHFlatComposite
TICKER=yahoo_adj_research_universe_hedge.json
DATA_PROVIDER=yahoo_adj
ALPACA_FEED=sip
FROM_DAYS=420
MAX_EXPOSURE=1
MARGIN_LEVERAGE=1
ENTRY_TIF=gtc
ENTRY_HANDLER=backtrader-entry
EXIT_HANDLER=moo-exit
EXIT_FALLBACK_HANDLER=moo-exit-fallback

STUDY5_WEIGHTS="c2c_mean_6m:0.017431,ah_mean_6m:0.284988,corr12:0.032938,atr_pct_cc_21:0.013094,sma_ratio_ah_252:0.000145,reg_slope_r2_ah_252:0.163547,intraday_vol_mean_42:0.111993,ah_gap_vol_mean_63:0.001711,reg_slope_ah_84:0.019210,rsi_wilder_ah_25:0.006527,sma_ratio_cc_200:0.000386,reg_slope_cc_168:0.000144,supertrend_dist_cc_10_3:0.141697,reg_slope_r2_cc_168:0.001254,rsi_wilder_cc_25:0.000238,relative_volume_10:0.005470,obv_slope_126:0.182745,log_macd_histo_cc:0.005619,stoch_rsi_ah:0.008682,log_macd_histo_ah:0.001209,stoch_rsi_cc:0.000972"

# post_up_cooldown_threshold ritarato da 0.05 a 0.01 (stesso motivo di
# overnight-ah-development.env): il trigger e' passato da PnL di uscita
# realizzato (mai osservabile in paper/live) a metrica price-derived
# cross-sectional (_ah_gain_universe_mean_today). 0.05 scattava solo 3 volte
# in 26 anni di storico (oltre p99.5, di fatto inerte); 0.01 e' stato
# validato con sweep Sharpe/SQN/MaxDD sia a sizing isolato (fixed_notional,
# per rimuovere il rumore del compounding) sia con il sizing reale
# (size_by_max_concurrent=True): vince su tutte e tre le metriche contro
# spento e contro le altre soglie candidate (0.008/0.0115/0.015).
# Parte dai primi 3 titoli ordinati per score composito. Se il cap dell'1%
# ADV non consente di raggiungere l'esposizione 1x, espande in ordine fino a 60.
STRATARGS="max_concurrent=60 min_concurrent=3 sizing_policy='liquidity_waterfall' max_adv_participation=0.01 size_by_max_concurrent=True max_exposure=$MAX_EXPOSURE min_intraday_vol=0 max_intraday_vol=999 intraday_vol_filter_side='any' ah_lag1_threshold=-0.1 entry_signal_lag_bars=1 min_adv=0 auction=False monthly_universe_mode='weak_theme_switch' monthly_universe_top_n=60 monthly_universe_switch_feature='semis_total_3m' monthly_universe_switch_threshold=0.0 monthly_universe_spy_dd3m_threshold=-0.10 hedge_enabled=False post_up_cooldown_threshold=0.01 post_up_cooldown_days=5 monthly_universe_score_mode='flat_panel' monthly_universe_indicator_panel='config-common/indicator_panel/flat_panel_live.csv' monthly_universe_flat_weights='$STUDY5_WEIGHTS'"
