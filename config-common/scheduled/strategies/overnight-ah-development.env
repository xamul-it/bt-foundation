# Development parameters. This file may diverge from production while tested
# through the development paper account.
STRAT=overnight_ah.OvernightAH
TICKER=yahoo_adj_research_universe_hedge.json
DATA_PROVIDER=yahoo_adj
ALPACA_FEED=sip
FROM_DAYS=420
MAX_EXPOSURE=2
MARGIN_LEVERAGE=2
ENTRY_TIF=gtc
ENTRY_HANDLER=backtrader-entry
EXIT_HANDLER=moo-exit
EXIT_FALLBACK_HANDLER=moo-exit-fallback
#STRATARGS="max_concurrent=5 size_by_max_concurrent=True max_exposure=$MAX_EXPOSURE min_intraday_vol=0.025 max_intraday_vol=0.045 intraday_vol_filter_side='any' ah_lag1_threshold=-0.1 min_adv=100000000 auction=False monthly_universe_mode='weak_theme_switch' monthly_universe_top_n=50 monthly_universe_base_weight=0.85 monthly_universe_theme_weight=0.15 monthly_universe_theme_score='corr12' monthly_universe_switch_feature='semis_total_3m' monthly_universe_switch_threshold=0.0 monthly_universe_spy_dd3m_threshold=-0.10"
#STRATARGS="max_concurrent=5 size_by_max_concurrent=True max_exposure=$MAX_EXPOSURE  min_intraday_vol=0.025 max_intraday_vol=0.045 intraday_vol_filter_side='any' ah_lag1_threshold=-0.1 min_adv=100000000 auction=False monthly_universe_mode='theme_switch' monthly_universe_top_n=50 monthly_universe_base_weight=0.85 monthly_universe_theme_weight=0.15 monthly_universe_theme_score='corr12' monthly_universe_switch_feature='semis_total_3m' monthly_universe_switch_threshold=0.0 monthly_universe_spy_dd3m_threshold=-0.10 post_up_cooldown_threshold=0.05 post_up_cooldown_days=5"
# Precedente STRATARGS attivo (min_intraday_vol/max_intraday_vol=0.025/0.045
# e min_adv=100000000) archiviato sotto per riferimento. Rimossi entrambi il
# 2026-08-16 su richiesta esplicita dell'utente, dopo lo studio di isolamento
# filtri in docs/context/ah_context.md ("Isolamento dei tre filtri operativi
# uno alla volta"): con hedge+cooldown+max_concurrent=3 invariati e
# ah_lag1_threshold ancora attivo, la simulazione Backtrader reale
# (2000-2026, controllo salvato come config-common/benchmark/
# overnight_ah_onlyahlag1_control.csv) mostra +21,77% di rendimento
# cumulativo per lo score composito rispetto allo score attuale in questa
# configurazione, contro uno scarto negativo (-10,43%/-10,78%) quando vol o
# ADV sono rimossi singolarmente lasciando l'altro attivo -- nessun singolo
# filtro isolato spiega da solo il recupero, interazione non additiva tra
# vol e ADV non ancora pienamente spiegata (vedi "Non-goal / stato" in
# ah_context.md). Nota: lo studio ha misurato lo score c2c/ah/theme
# ATTUALE (non il composito Studio 5, che resta backtest-only,
# live_enabled=False) -- la rimozione dei due filtri qui sotto e' quindi
# validata solo per la strategia in produzione, non implica un cambio di
# scoring.
# Precedente STRATARGS attivo (hedge_fast_period/hedge_slow_period=65/150,
# ah_lag1_threshold=-0.1, post_up_cooldown_threshold/days=0.05/5) archiviato
# sotto per riferimento. Aggiornato 2026-08-18 su richiesta esplicita
# dell'utente dopo lo studio in docs/context/ah_context.md ("Bug dati SQQQ" +
# "Ritaratura ah_lag1/cooldown sopra i parametri hedge scelti"):
# - hedge_fast_period/hedge_slow_period 65/150 -> 50/120: unico miglioramento
#   confermato pulito su rendimento+Sharpe+drawdown insieme (controllo
#   backtest 2000-2026, fixed_notional $20k/trade: +175,94% vs +171,95% sul
#   periodo con dati SQQQ validati 2016-2026, Sharpe 2,132 vs 2,100, maxDD
#   -4,26% vs -5,21%).
# - ah_lag1_threshold -0.1 -> -0.20, post_up_cooldown_threshold/days
#   0.05/5 -> 0.03/3: combinazione testata esplicitamente insieme (non solo
#   sommando gli effetti singoli, mai additivi in questa sessione) sopra la
#   nuova base hedge 50/120: rendimento 352,16% (contro 362,31% del
#   controllo 50/120 con parametri vecchi ah_lag1/cooldown), ma Sharpe
#   1,460 (vs 1,356) e maxDD -7,09% (vs -8,81%) -- miglior punto
#   risk-adjusted trovato nell'intera griglia, run id
#   fn_ema_combined_candidate, 2000-2026, 0 errori/warning.
# - hedge_weight=0.15 invariato: aumentarlo (testato fino a 0,50) migliora
#   solo il rendimento assoluto aggiungendo leva su SQQQ (-3x decadente),
#   peggiora Sharpe e drawdown in modo monotono -- 0,15 resta il punto
#   migliore risk-adjusted.
#STRATARGS_PRECEDENTE="max_concurrent=3 size_by_max_concurrent=True max_exposure=$MAX_EXPOSURE min_intraday_vol=0 max_intraday_vol=999 intraday_vol_filter_side='any' ah_lag1_threshold=-0.1 min_adv=0 auction=False monthly_universe_mode='weak_theme_switch' monthly_universe_top_n=50 monthly_universe_base_weight=0.85 monthly_universe_theme_weight=0.15 monthly_universe_theme_score='corr12' monthly_universe_switch_feature='semis_total_3m' monthly_universe_switch_threshold=0.0 monthly_universe_spy_dd3m_threshold=-0.10 hedge_enabled=True hedge_symbol='SQQQ' hedge_trend_symbol='QQQ' hedge_fast_period=65 hedge_slow_period=150 hedge_weight=0.15 post_up_cooldown_threshold=0.05 post_up_cooldown_days=5"
STRATARGS="max_concurrent=3 size_by_max_concurrent=True max_exposure=$MAX_EXPOSURE min_intraday_vol=0 max_intraday_vol=999 intraday_vol_filter_side='any' ah_lag1_threshold=-0.20 min_adv=0 auction=False monthly_universe_mode='weak_theme_switch' monthly_universe_top_n=50 monthly_universe_base_weight=0.85 monthly_universe_theme_weight=0.15 monthly_universe_theme_score='corr12' monthly_universe_switch_feature='semis_total_3m' monthly_universe_switch_threshold=0.0 monthly_universe_spy_dd3m_threshold=-0.10 hedge_enabled=True hedge_symbol='SQQQ' hedge_trend_symbol='QQQ' hedge_fast_period=50 hedge_slow_period=120 hedge_weight=0.15 post_up_cooldown_threshold=0.03 post_up_cooldown_days=3"
