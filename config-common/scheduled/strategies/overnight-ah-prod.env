# Production promotion of the validated `development` OvernightAH profile.
# `live` and `mirror` deliberately consume this same file from the same
# pinned production checkout, so their strategy parameters stay identical.
STRAT=overnight_ah.OvernightAH
TICKER=yahoo_adj_research_universe_hedge.json
DATA_PROVIDER=yahoo_adj
REFRESH_MARKET_DATA=0
ALPACA_FEED=sip
FROM_DAYS=420
MAX_EXPOSURE=1
MARGIN_LEVERAGE=1
COMMISSION=alpaca
ENTRY_TIF=cls
ENTRY_HANDLER=backtrader-entry
EXIT_HANDLER=moo-exit
EXIT_FALLBACK_HANDLER=moo-exit-fallback
# This is the development configuration promoted as-is in operational terms:
# 1x liquidity-aware waterfall, three initial equal-weight slots, 1% ADV cap,
# breadth expansion up to 50 names, no legacy volatility/ADV filters and no
# hedge.  Do not add `opg_failed_hold_if_eligible` here until its uncommitted
# bt-core implementation is separately reviewed and released; its development
# value is currently 0, so omitting it preserves the same behaviour.
STRATARGS="max_concurrent=50 min_concurrent=3 sizing_policy='liquidity_waterfall' max_adv_participation=0.01 size_by_max_concurrent=True max_exposure=$MAX_EXPOSURE min_intraday_vol=0 max_intraday_vol=999 intraday_vol_filter_side='any' ah_lag1_threshold=-0.20 entry_signal_lag_bars=1 live_use_last_completed_bar=True live_reenter_positions_pending_fallback=True min_adv=0 auction=True monthly_universe_mode='weak_theme_switch' monthly_universe_top_n=50 monthly_universe_base_weight=0.85 monthly_universe_theme_weight=0.15 monthly_universe_theme_score='corr12' monthly_universe_switch_feature='semis_total_3m' monthly_universe_switch_threshold=0.0 monthly_universe_spy_dd3m_threshold=-0.10 hedge_enabled=False post_up_cooldown_threshold=0.01 post_up_cooldown_days=3"
