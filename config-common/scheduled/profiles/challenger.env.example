ROLE=challenger
TRADING_MODE=paper
# CODE_ROOT points at the research repo (not backtrader-prod): the
# experimental strategy under test (e.g. overnight_ah_flat_composite) lives
# here, not in the frozen prod checkout. Same pattern as "development".
CODE_ROOT=/home/htpc/backtrader
ACCOUNT_ENV=/home/htpc/.config/backtrader/accounts/challenger.env
# Point this at a dedicated versioned parameter file when starting a test.
STRATEGY_CONFIG=config-common/scheduled/strategies/overnight-ah-challenger.env
RUN_ID=overnight_ah_challenger
