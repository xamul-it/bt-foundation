[Unit]
Description=Backtrader API (%i)
After=network-online.target

[Service]
WorkingDirectory=/home/htpc/backtrader/bt-api
EnvironmentFile=/home/htpc/backtrader/env/bt-api-%i
ExecStart=/home/htpc/backtrader/bt-api/start.sh
Restart=on-failure
RestartSec=5

# Memory guard (2026-08-29 host-freeze incident): cap this service's own
# cgroup so a runaway process here gets throttled/killed cleanly instead of
# swap-thrashing the whole shared host. Normal usage is ~350-650MB.
MemoryAccounting=yes
MemoryHigh=1536M
MemoryMax=3072M
MemorySwapMax=0
ManagedOOMMemoryPressure=kill
ManagedOOMSwap=kill

[Install]
WantedBy=default.target
