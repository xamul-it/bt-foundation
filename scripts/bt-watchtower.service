[Unit]
Description=Backtrader Paper/Sim Watchtower
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/home/htpc/backtrader/bt-core
ExecStart=/bin/bash -lc 'set -a; source /home/htpc/backtrader/env/bt-live-events; set +a; exec /home/htpc/backtrader/bt-core/.venv/bin/python ./reconciliation_watchdog.py --db-dsn "$LIVE_EVENTS_DB_DSN" --poll-seconds "${BT_WATCHTOWER_POLL_SECONDS:-5}" --log-level="${BT_WATCHTOWER_LOG_LEVEL:-INFO}"'

StandardOutput=append:/home/htpc/backtrader/logs/bt-watchtower.log
StandardError=append:/home/htpc/backtrader/logs/bt-watchtower.log

Restart=on-failure
RestartSec=5s

# Memory guard (2026-08-29 host-freeze incident): cap this service's own
# cgroup so a runaway process here gets throttled/killed cleanly instead of
# swap-thrashing the whole shared host. Lightweight poller, normal usage low.
MemoryAccounting=yes
MemoryHigh=512M
MemoryMax=1024M
MemorySwapMax=0
ManagedOOMMemoryPressure=kill
ManagedOOMSwap=kill

[Install]
WantedBy=default.target
