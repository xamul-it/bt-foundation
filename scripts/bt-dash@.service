[Unit]
Description=Backtrader Dashboard Quasar dev server (%i)
After=network-online.target bt-api@%i.service

[Service]
WorkingDirectory=/home/htpc/backtrader/bt-dash
Environment=PATH=/home/htpc/.nvm/versions/node/v20.20.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/home/htpc/backtrader/env/bt-dash-%i
ExecStart=/bin/bash -lc 'exec npx quasar dev -m pwa --hostname "${BT_DASH_HOST:-127.0.0.1}"'
Restart=on-failure
RestartSec=5

# Memory guard (2026-08-29 host-freeze incident): cap this service's own
# cgroup so a runaway process here gets throttled/killed cleanly instead of
# swap-thrashing the whole shared host. Node/quasar dev server, allow more
# headroom for builds/HMR than the lightweight python services.
MemoryAccounting=yes
MemoryHigh=1024M
MemoryMax=2048M
MemorySwapMax=0
ManagedOOMMemoryPressure=kill
ManagedOOMSwap=kill

[Install]
WantedBy=default.target
